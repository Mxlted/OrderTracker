        <Style x:Key="CellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontStretch" Value="SemiCondensed"/>
        </Style>

        <Style x:Key="CompactCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="CellTextWithToolTipStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactCellTextWithToolTipStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CompactCellTextStyle}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderGridItemTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderGridSubTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontStretch" Value="SemiCondensed"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="OrderGridLinkTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="ExpandedDetailsBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="42,2,8,5"/>
        </Style>

        <Style x:Key="ExpandedDetailsHeaderTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="ExpandedItemNameTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CellTextWithToolTipStyle}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontStretch" Value="Normal"/>
        </Style>

        <Style x:Key="ExpandedItemValueTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="MinHeight" Value="124"/>
            <Setter Property="Margin" Value="0,0,12,14"/>
        </Style>

        <Style x:Key="DashboardMetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <Style x:Key="ChartValueTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ChartBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="PART_Track"
                              ClipToBounds="True"
                              SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/app-icon.png"
                               Width="42"
                               Height="42"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Order Tracker"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Purchases, tracking, and spend"
                                       Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Dashboard"/>
                    <Button Content="Orders"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Orders"/>
                    <Button Content="Archive"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Archive"/>
                    <Button Content="Accounts"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Accounts"/>
                    <Button Content="Item presets"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Presets"/>
                    <Button Content="Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="SidebarStatusScrollColumn" Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="SidebarStatusScrollViewer"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Status"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding LastActionMessage}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextBrush}"/>

                                    <TextBlock Text="Alerts"
                                               Style="{StaticResource SidebarSectionTitleStyle}"/>
                                    <ItemsControl ItemsSource="{Binding SidebarAlerts}"
                                                  ItemTemplate="{StaticResource SidebarPanelItemTemplate}"/>

                                    <TextBlock Text="Quick actions"
                                               Style="{StaticResource SidebarSectionTitleStyle}"/>
                                    <Button Content="+ New order"
                                            Command="{Binding ToggleQuickOrderCommand}"
                                            Tag="{Binding IsOrderEditorOpen}"
                                            Style="{StaticResource SidebarQuickActionButtonStyle}"/>
                                    <Button Content="+ New account"
                                            Command="{Binding ToggleQuickAccountPresetCommand}"
                                            Tag="{Binding IsAccountPresetEditorOpen}"
                                            Style="{StaticResource SidebarQuickActionButtonStyle}"/>
                                    <Button Content="+ New preset"
                                            Command="{Binding ToggleQuickPresetCommand}"
                                            Tag="{Binding IsPresetEditorOpen}"
                                            Style="{StaticResource SidebarQuickActionButtonStyle}"/>
                                    <Button Content="Archive ready"
                                            Command="{Binding ArchiveCompletedOrdersCommand}"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            ToolTip="{Binding ArchiveCompletedOrdersLabel}"/>
                                    <Button Content="Discord stats"
                                            Command="{Binding SendDiscordStatsCommand}"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            Margin="0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="SidebarStatusScrollRail"
                                    Grid.Column="1"
                                    Background="{DynamicResource ScrollBarTrackBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed">
                                <Canvas x:Name="SidebarStatusScrollCanvas"
                                        Background="Transparent">
                                    <Thumb x:Name="SidebarStatusScrollThumb"
                                           Width="12"
                                           MinHeight="56"
                                           Cursor="SizeNS"
                                           Canvas.Left="1"
                                           Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Canvas>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SidebarDate}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextTrimming="None"/>
                                <TextBlock Text="{Binding SidebarTime}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="28,24,28,14">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="A quick read on order status, spend, and delivery flow." Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="DashboardScrollColumn" Width="18"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="DashboardScrollViewer"
                                  Grid.Column="0"
                                  Style="{StaticResource ModernScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding MetricCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Width="34"
                                                    Height="4"
                                                    Background="{Binding Accent}"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,12"/>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}"/>
                                                <TextBlock Text="{Binding Value}"
                                                           Style="{StaticResource DashboardMetricValueStyle}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Detail}"
                                                       Style="{StaticResource CaptionTextStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18"
                                    Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="Monthly spend" Style="{StaticResource SectionTitleStyle}"/>
                                    <ItemsControl ItemsSource="{Binding MonthlySpend}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="84"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Percent}"
                                                                 Foreground="{Binding Accent}"
                                                                 Style="{StaticResource ChartBarStyle}"
                                                                 Margin="0,0,14,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Style="{StaticResource ChartValueTextStyle}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Status breakdown" Style="{StaticResource SectionTitleStyle}"/>
                                        <ItemsControl ItemsSource="{Binding StatusBreakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="126"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="1"
                                                                     Value="{Binding Percent}"
                                                                     Foreground="{Binding Accent}"
                                                                     Style="{StaticResource ChartBarStyle}"
                                                                     Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Style="{StaticResource ChartValueTextStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Merchant spend" Style="{StaticResource SectionTitleStyle}"/>
                                        <ItemsControl ItemsSource="{Binding MerchantSpend}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="108"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="1"
                                                                     Value="{Binding Percent}"
                                                                     Foreground="{Binding Accent}"
                                                                     Style="{StaticResource ChartBarStyle}"
                                                                     Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Style="{StaticResource ChartValueTextStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Yearly totals" Style="{StaticResource SectionTitleStyle}"/>
                                        <ItemsControl ItemsSource="{Binding YearlySpend}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="1"
                                                                     Value="{Binding Percent}"
                                                                     Foreground="{Binding Accent}"
                                                                     Style="{StaticResource ChartBarStyle}"
                                                                     Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Style="{StaticResource ChartValueTextStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="DashboardScrollRail"
                            Grid.Column="1"
                            Background="{DynamicResource ScrollBarTrackBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="2,0,0,0"
                            Visibility="Collapsed">
                        <Canvas x:Name="DashboardScrollCanvas"
                                Background="Transparent">
                            <Thumb x:Name="DashboardScrollThumb"
                                   Width="12"
                                   MinHeight="56"
                                   Cursor="SizeNS"
                                   Canvas.Left="1"
                                   Style="{StaticResource ScrollBarThumbStyle}"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Orders}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Orders" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Track merchants, costs, dates, tracking numbers, and completion state." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="{Binding ArchiveCompletedOrdersLabel}"
                                Command="{Binding ArchiveCompletedOrdersCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="New order" Command="{Binding NewOrderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Save order"
                                Command="{Binding SaveOrderCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsOrderEditorOpen, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding Data.IsOrderEditorOpen, Source={StaticResource VmProxy}, Converter={StaticResource BoolToGridLength}, ConverterParameter=400}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="Search orders"
                                     Margin="0,0,10,0"
                                     ToolTip="Search orders"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GroupOptions}"
                                      SelectedItem="{Binding SelectedGroup}"
                                      Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort}"
                                      Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="3"
                                      Content="Hide completed"
                                      IsChecked="{Binding HideCompleted}"
                                      VerticalAlignment="Center"/>
                            <WrapPanel Grid.Row="1"
                                       Grid.ColumnSpan="4"
                                       Margin="0,10,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveOrderBulkSelectionSummary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="{Binding VisibleOrderItemsExpansionToggleLabel}"
                                        Command="{Binding ToggleVisibleOrderItemsExpansionCommand}"
                                        ToolTip="{Binding VisibleOrderItemsExpansionToggleToolTip}"
                                        MinWidth="74"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Select"
                                        Command="{x:Static local:MainWindow.SelectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=OrdersGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect"
                                        Command="{x:Static local:MainWindow.UnselectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=OrdersGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Select all"
                                        Command="{Binding SelectVisibleOrdersCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect all"
                                        Command="{Binding ClearSelectedOrdersCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Mark completed"
                                        Command="{Binding MarkSelectedOrdersCompletedCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Archive selected completed"
                                        Command="{Binding ArchiveSelectedCompletedOrdersCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Delete selected"
                                        Command="{Binding DeleteSelectedOrdersCommand}"
                                        Style="{StaticResource BulkDangerActionButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="0"
                          Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="OrdersScrollColumn" Width="18"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="OrdersGrid"
                                  Grid.Column="0"
                                  ItemsSource="{Binding OrdersView}"
                                  SelectedItem="{Binding SelectedOrder}"
                                  RowStyle="{StaticResource OrderRowStyle}"
                                  SelectionChanged="SelectableGridSelectionChanged"
                                  AlternationCount="2"
                                  RowDetailsVisibilityMode="Visible"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.CanContentScroll="False"
                                  ColumnWidth="*"
                                  Margin="0">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True"
                                                              Background="{DynamicResource SurfaceAltBrush}"
                                                              Foreground="{DynamicResource TextBrush}"
                                                              BorderBrush="{DynamicResource BorderBrush}"
                                                              BorderThickness="0,0,0,1"
                                                              Padding="10,8">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource ExpandedDetailsBorderStyle}"
                                            Visibility="{Binding IsItemsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Item" Style="{StaticResource ExpandedDetailsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="1" Text="Qty" Style="{StaticResource ExpandedDetailsHeaderTextStyle}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="Unit" Style="{StaticResource ExpandedDetailsHeaderTextStyle}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource ExpandedDetailsHeaderTextStyle}" TextAlignment="Right"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="90"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ExpandedItemNameTextStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Style="{StaticResource ExpandedItemValueTextStyle}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat=C}" Style="{StaticResource ExpandedItemValueTextStyle}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat=C, Mode=OneWay}" Style="{StaticResource ExpandedItemValueTextStyle}" TextAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ExpandedDetailsBorderStyle}"
                                            Visibility="{Binding IsTrackingExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tracking" Style="{StaticResource ExpandedDetailsHeaderTextStyle}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TrackingCountSummary}"
                                                           Style="{StaticResource ExpandedDetailsHeaderTextStyle}"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding TrackingNumbers}"
                                                          ItemTemplate="{StaticResource TrackingChipTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header=""
                                                    Width="Auto"
                                                    MinWidth="34"
                                                    MaxWidth="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="Select order for bulk actions"
                                                  HorizontalAlignment="Center"
                                                  Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Merchant"
                                                    Width="0.7*"
                                                    MinWidth="64"
                                                    MaxWidth="92"
                                                    Visibility="{Binding Data.Settings.Columns.ShowMerchant, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="15"
                                                    Background="{Binding Merchant, Converter={StaticResource MerchantBrush}}"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding MerchantIcon}"
                                                           Foreground="{DynamicResource ChipTextBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Merchant}"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Account"
                                                Width="1.05*"
                                                MinWidth="100"
                                                Binding="{Binding AccountEmail}"
                                                ElementStyle="{StaticResource CompactCellTextWithToolTipStyle}"
                                                Visibility="{Binding Data.Settings.Columns.ShowAccount, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}"/>

                            <DataGridTemplateColumn Header="Order"
                                                    Width="1.15*"
                                                    MinWidth="124"
                                                    Visibility="{Binding Data.Settings.Columns.ShowOrderNumber, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Data.OpenOrderLinkCommand, Source={StaticResource VmProxy}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                ToolTip="{Binding OrderNumber}">
                                            <TextBlock Text="{Binding OrderNumber}"
                                                       Style="{StaticResource OrderGridLinkTextStyle}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Items"
                                                    Width="0.55*"
                                                    MinWidth="70"
                                                    MaxWidth="90"
                                                    Visibility="{Binding Data.Settings.Columns.ShowItem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center"
                                              ToolTip="{Binding ItemsToolTip}"
                                              ToolTipService.InitialShowDelay="0"
                                              ToolTipService.BetweenShowDelay="0"
                                              ToolTipService.ShowDuration="60000">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton IsChecked="{Binding IsItemsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Toggle item details"
                                                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                                                          Style="{StaticResource ExpandToggleButtonStyle}"
                                                          ToolTip="{Binding ItemsToolTip}"
                                                          Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ItemCountSummary}"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Qty"
                                                Width="0.38*"
                                                MinWidth="44"
                                                MaxWidth="54"
                                                Binding="{Binding TotalQuantity, Mode=OneWay}"
                                                ElementStyle="{StaticResource CompactCellTextStyle}"
                                                Visibility="{Binding Data.Settings.Columns.ShowQuantity, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}"/>

                            <DataGridTemplateColumn Header="Status"
                                                    Width="0.95*"
                                                    MinWidth="92"
                                                    MaxWidth="112"
                                                    Visibility="{Binding Data.Settings.Columns.ShowStatus, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Data.OrderStatuses, Source={StaticResource VmProxy}}"
                                                  SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                  Foreground="{DynamicResource ChipTextBrush}"
                                                  BorderBrush="Transparent"
                                                  MinWidth="72"
                                                  MinHeight="28"
                                                  FontSize="11"
                                                  Padding="5,2"
                                                  ToolTip="Change status"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Tracking"
                                                    Width="1.45*"
                                                    MinWidth="150"
                                                    Visibility="{Binding Data.Settings.Columns.ShowTracking, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton IsChecked="{Binding IsTrackingExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Toggle tracking details"
                                                          Visibility="{Binding HasMultipleTrackingNumbers, Converter={StaticResource BoolToVisibility}}"
                                                          Style="{StaticResource ExpandToggleButtonStyle}"
                                                          ToolTip="Show tracking numbers"
                                                          Margin="0,0,6,0"/>
                                            <StackPanel Grid.Column="1">
                                                <ContentControl Content="{Binding PrimaryTracking}"
                                                                ContentTemplate="{StaticResource TrackingChipTemplate}"
                                                                Visibility="{Binding HasTrackingNumbers, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding TrackingCountSummary}"
                                                           Style="{StaticResource OrderGridSubTextStyle}"
                                                           Visibility="{Binding HasMultipleTrackingNumbers, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Dates"
                                                    Width="1.0*"
                                                    MinWidth="108"
                                                    MaxWidth="124"
                                                    Visibility="{Binding Data.Settings.Columns.ShowDates, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderDate, StringFormat='Ordered {0:M/d/yy}'}" Style="{StaticResource CompactCellTextStyle}"/>
                                            <TextBlock Text="{Binding ExpectedDate, StringFormat='Expected {0:M/d/yy}'}" Style="{StaticResource OrderGridSubTextStyle}"/>
                                            <TextBlock Text="{Binding DeliveredDate, StringFormat='Delivered {0:M/d/yy}'}" Style="{StaticResource OrderGridSubTextStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Total"
                                                Width="0.65*"
                                                MinWidth="74"
                                                MaxWidth="88"
                                                Binding="{Binding TotalCost, StringFormat=C, Mode=OneWay}"
                                                ElementStyle="{StaticResource CompactCellTextWithToolTipStyle}"
                                                Visibility="{Binding Data.Settings.Columns.ShowTotal, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}"/>

                            <DataGridTemplateColumn Header="Actions"
                                                    Width="1.35*"
                                                    MinWidth="150"
                                                    MaxWidth="166"
                                                    Visibility="{Binding Data.Settings.Columns.ShowActions, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit"
                                                    Command="{Binding Data.EditOrderCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GridActionButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Done"
                                                    Command="{Binding Data.ToggleCompletedCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GridActionButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Copy"
                                                    Command="{Binding Data.CopyTrackingNumbersCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GridActionButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="OrdersScrollRail"
                                Grid.Column="1"
                                Background="{DynamicResource ScrollBarTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="2,0,0,0"
                                Visibility="Collapsed">
                            <Canvas x:Name="OrdersScrollCanvas"
                                    Background="Transparent">
                                <Thumb x:Name="OrdersScrollThumb"
                                       Width="12"
                                       MinHeight="56"
                                       Cursor="SizeNS"
                                       Canvas.Left="1"
                                       Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Canvas>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1"
                            Grid.RowSpan="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="14,0,0,0"
                            Visibility="{Binding IsOrderEditorOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="OrderEditorScrollColumn" Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="OrderEditorScrollViewer"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OrderEditorTitle}"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Close"
                                            Command="{Binding CloseOrderEditorCommand}"
                                            Padding="10,5"
                                            MinHeight="30"/>
                                </Grid>

                                <Border Style="{StaticResource OrderEditorFirstSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Presets" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <TextBlock Text="Item preset" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ItemPresets}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedOrderPreset}"/>

                                        <TextBlock Text="Account preset" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AccountPresets}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedOrderAccountPreset}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Order details" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Account/email" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding FormAccountEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Merchant" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding Merchants}" SelectedItem="{Binding FormMerchant}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Order number" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding FormOrderNumber, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Order link" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding FormOrderLink, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Items"
                                                       Style="{StaticResource OrderEditorSectionTitleStyle}"
                                                       Margin="0"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="Add item"
                                                    Command="{Binding AddOrderItemCommand}"
                                                    Padding="10,5"
                                                    MinHeight="30"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding FormItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="12"
                                                            Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                                                     Tag="Item name"
                                                                     ToolTip="Item name"
                                                                     Margin="0,0,0,9"/>
                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="74"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                    <TextBlock Text="Qty" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                                    <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                                                             Tag="1"
                                                                             TextAlignment="Right"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="Unit price" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                                    <TextBox Text="{Binding UnitPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                                                             Tag="0.00"
                                                                             TextAlignment="Right"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                                                        Content="Remove"
                                                                        Command="{Binding Data.RemoveOrderItemCommand, Source={StaticResource VmProxy}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource DangerButtonStyle}"
                                                                        Padding="9,5"
                                                                        MinHeight="34"
                                                                        VerticalAlignment="Bottom"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Costs" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="108"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Shipping" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding FormShippingCostInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="0.00"
                                                         TextAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Tax" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding FormTaxInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="0.00"
                                                         TextAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="ROI override" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding FormProjectedRoiPercentInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="Global"
                                                         TextAlignment="Right"
                                                         ToolTip="Blank uses merchant ROI."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Dates and status" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Order date" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <DatePicker SelectedDate="{Binding FormOrderDate}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Expected" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <DatePicker SelectedDate="{Binding FormExpectedDate}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Status" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding OrderStatuses}" SelectedItem="{Binding FormStatus}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Delivered" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <DatePicker SelectedDate="{Binding FormDeliveredDate}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Tracking" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <TextBlock Text="Tracking status" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                        <TextBox Text="{Binding FormTrackingStatus, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Tracking numbers" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding FormTrackingNumbersText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="84"
                                                 VerticalScrollBarVisibility="Auto"/>

                                        <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="76"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <Button Content="Save"
                                                Command="{Binding SaveOrderCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinHeight="38"
                                                Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="New"
                                                    Command="{Binding NewOrderCommand}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Close"
                                                    Command="{Binding CloseOrderEditorCommand}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="4,0,0,0"/>
                                        </UniformGrid>
                                        <UniformGrid Columns="2">
                                            <Button Content="Toggle completed"
                                                    Command="{Binding ToggleCompletedCommand}"
                                                    CommandParameter="{Binding SelectedOrder}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Duplicate"
                                                    Command="{Binding DuplicateOrderCommand}"
                                                    CommandParameter="{Binding SelectedOrder}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="4,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="OrderEditorScrollRail"
                                    Grid.Column="1"
                                    Background="{DynamicResource ScrollBarTrackBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed">
                                <Canvas x:Name="OrderEditorScrollCanvas"
                                        Background="Transparent">
                                    <Thumb x:Name="OrderEditorScrollThumb"
                                           Width="12"
                                           MinHeight="56"
                                           Cursor="SizeNS"
                                           Canvas.Left="1"
                                           Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Canvas>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Archive}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Archive" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="{Binding ArchivedOrderSummary}" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding ArchiveSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="Search archived orders"
                                     ToolTip="Search archived orders"/>
                            <WrapPanel Grid.Row="1"
                                       Margin="0,10,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock Text="{Binding ArchivedOrderBulkSelectionSummary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="Select"
                                        Command="{x:Static local:MainWindow.SelectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=ArchiveGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect"
                                        Command="{x:Static local:MainWindow.UnselectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=ArchiveGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Select all"
                                        Command="{Binding SelectVisibleArchivedOrdersCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect all"
                                        Command="{Binding ClearSelectedArchivedOrdersCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Restore selected"
                                        Command="{Binding RestoreSelectedOrdersCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Delete selected"
                                        Command="{Binding DeleteSelectedArchivedOrdersCommand}"
                                        Style="{StaticResource BulkDangerActionButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ArchiveScrollColumn" Width="18"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="ArchiveGrid"
                                  Grid.Column="0"
                                  ItemsSource="{Binding ArchivedOrdersView}"
                                  SelectedItem="{Binding SelectedOrder}"
                                  RowStyle="{StaticResource ArchiveOrderRowStyle}"
                                  SelectionChanged="SelectableGridSelectionChanged"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.CanContentScroll="False"
                                  ColumnWidth="*">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header=""
                                                        Width="Auto"
                                                        MinWidth="34"
                                                        MaxWidth="38">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="Select archived order for bulk actions"
                                                      HorizontalAlignment="Center"
                                                      Margin="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Merchant"
                                                        Width="0.7*"
                                                        MinWidth="64"
                                                        MaxWidth="92"
                                                        Visibility="{Binding Data.Settings.Columns.ShowMerchant, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30"
                                                        Height="30"
                                                        CornerRadius="15"
                                                        Background="{Binding Merchant, Converter={StaticResource MerchantBrush}}"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding MerchantIcon}"
                                                               Foreground="{DynamicResource ChipTextBrush}"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Merchant}"
                                                           Style="{StaticResource CompactCellTextStyle}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Account"
                                                    Width="1.05*"
                                                    MinWidth="100"
                                                    Binding="{Binding AccountEmail}"
                                                    ElementStyle="{StaticResource CompactCellTextWithToolTipStyle}"
                                                    Visibility="{Binding Data.Settings.Columns.ShowAccount, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}"/>

                                <DataGridTemplateColumn Header="Order"
                                                        Width="1.15*"
                                                        MinWidth="124"
                                                        Visibility="{Binding Data.Settings.Columns.ShowOrderNumber, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Data.OpenOrderLinkCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    ToolTip="{Binding OrderNumber}">
                                                <TextBlock Text="{Binding OrderNumber}"
                                                           Style="{StaticResource OrderGridLinkTextStyle}"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Items"
                                                        Width="0.55*"
                                                        MinWidth="70"
                                                        MaxWidth="90"
                                                        Visibility="{Binding Data.Settings.Columns.ShowItem, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ItemCountSummary}"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding ItemsToolTip}"
                                                       ToolTipService.InitialShowDelay="0"
                                                       ToolTipService.BetweenShowDelay="0"
                                                       ToolTipService.ShowDuration="60000"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Qty"
                                                    Width="0.38*"
                                                    MinWidth="44"
                                                    MaxWidth="54"
                                                    Binding="{Binding TotalQuantity, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CompactCellTextStyle}"
                                                    Visibility="{Binding Data.Settings.Columns.ShowQuantity, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}"/>

                                <DataGridTemplateColumn Header="Status"
                                                        Width="0.9*"
                                                        MinWidth="88"
                                                        MaxWidth="112"
                                                        Visibility="{Binding Data.Settings.Columns.ShowStatus, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                    CornerRadius="7"
                                                    Padding="6,4"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{DynamicResource ChipTextBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.5"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Tracking"
                                                        Width="1.45*"
                                                        MinWidth="150"
                                                        Visibility="{Binding Data.Settings.Columns.ShowTracking, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ContentControl Content="{Binding PrimaryTracking}"
                                                                ContentTemplate="{StaticResource TrackingChipTemplate}"
                                                                Visibility="{Binding HasTrackingNumbers, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding TrackingCountSummary}"
                                                           Style="{StaticResource OrderGridSubTextStyle}"
                                                           Visibility="{Binding HasMultipleTrackingNumbers, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Dates"
                                                        Width="0.95*"
                                                        MinWidth="102"
                                                        MaxWidth="120"
                                                        Visibility="{Binding Data.Settings.Columns.ShowDates, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding OrderDate, StringFormat='Ordered {0:M/d/yy}'}" Style="{StaticResource CompactCellTextStyle}"/>
                                                <TextBlock Text="{Binding DeliveredDate, StringFormat='Delivered {0:M/d/yy}'}" Style="{StaticResource OrderGridSubTextStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Total"
                                                    Width="0.65*"
                                                    MinWidth="74"
                                                    MaxWidth="88"
                                                    Binding="{Binding TotalCost, StringFormat=C, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CompactCellTextWithToolTipStyle}"
                                                    Visibility="{Binding Data.Settings.Columns.ShowTotal, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}"/>

                                <DataGridTemplateColumn Header="Actions"
                                                        Width="1.45*"
                                                        MinWidth="166"
                                                        MaxWidth="184"
                                                        Visibility="{Binding Data.Settings.Columns.ShowActions, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Restore"
                                                        Command="{Binding Data.RestoreOrderCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GridActionButtonStyle}"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="Copy"
                                                        Command="{Binding Data.CopyTrackingNumbersCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GridActionButtonStyle}"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="Delete"
                                                        Command="{Binding Data.DeleteOrderCommand, Source={StaticResource VmProxy}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GridDangerActionButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="ArchiveScrollRail"
                                Grid.Column="1"
                                Background="{DynamicResource ScrollBarTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="2,0,0,0"
                                Visibility="Collapsed">
                            <Canvas x:Name="ArchiveScrollCanvas"
                                    Background="Transparent">
                                <Thumb x:Name="ArchiveScrollThumb"
                                       Width="12"
                                       MinHeight="56"
                                       Cursor="SizeNS"
                                       Canvas.Left="1"
                                       Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Accounts}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Accounts" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Reusable account emails with merchant hints, notes, favorites, and usage counts." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="New account" Command="{Binding NewAccountPresetCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save account"
                                Command="{Binding SaveAccountPresetCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsAccountPresetEditorOpen, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding Data.IsAccountPresetEditorOpen, Source={StaticResource VmProxy}, Converter={StaticResource BoolToGridLength}, ConverterParameter=380}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding AccountPresetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="Search accounts"
                                     ToolTip="Search accounts"/>
                            <WrapPanel Grid.Row="1"
                                       Margin="0,10,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountPresetBulkSelectionSummary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="Select"
                                        Command="{x:Static local:MainWindow.SelectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=AccountsGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect"
                                        Command="{x:Static local:MainWindow.UnselectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=AccountsGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Select all"
                                        Command="{Binding SelectVisibleAccountPresetsCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect all"
                                        Command="{Binding ClearSelectedAccountPresetsCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Delete selected"
                                        Command="{Binding DeleteSelectedAccountPresetsCommand}"
                                        Style="{StaticResource BulkDangerActionButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="0"
                          Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="AccountsScrollColumn" Width="18"/>
                        </Grid.ColumnDefinitions>
                            <DataGrid x:Name="AccountsGrid"
                                      Grid.Column="0"
                                      ItemsSource="{Binding AccountPresetsView}"
                                      SelectedItem="{Binding SelectedAccountPreset}"
                                      AutoGenerateColumns="False"
                                      RowStyle="{StaticResource AccountPresetRowStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.CanContentScroll="False"
                                      SelectionChanged="SelectableGridSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="34" MaxWidth="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Select account preset for bulk actions"
                                                          HorizontalAlignment="Center"
                                                          Margin="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="*" ElementStyle="{StaticResource CellTextWithToolTipStyle}"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" ElementStyle="{StaticResource CellTextWithToolTipStyle}"/>
                                    <DataGridTextColumn Header="Merchant" Binding="{Binding MerchantHint}" Width="120" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTemplateColumn Header="Fav" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Favorite account preset"
                                                          HorizontalAlignment="Center"
                                                          Margin="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Used" Binding="{Binding UsageCount}" Width="70" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTemplateColumn Header="Actions" Width="314">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Edit"
                                                            Command="{Binding Data.EditAccountPresetCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            Margin="0,0,5,0"/>
                                                    <Button Content="Apply"
                                                            Command="{Binding Data.ApplyAccountPresetCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            Margin="0,0,5,0"/>
                                                    <Button Content="View orders"
                                                            Command="{Binding Data.ViewAccountOrdersCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            Margin="0,0,5,0"/>
                                                    <Button Content="Delete"
                                                            Command="{Binding Data.DeleteAccountPresetCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridDangerActionButtonStyle}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        <Border x:Name="AccountsScrollRail"
                                Grid.Column="1"
                                Background="{DynamicResource ScrollBarTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="2,0,0,0"
                                Visibility="Collapsed">
                            <Canvas x:Name="AccountsScrollCanvas"
                                    Background="Transparent">
                                <Thumb x:Name="AccountsScrollThumb"
                                       Width="12"
                                       MinHeight="56"
                                       Cursor="SizeNS"
                                       Canvas.Left="1"
                                       Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Canvas>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1"
                            Grid.RowSpan="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="14,0,0,0"
                            Visibility="{Binding IsAccountPresetEditorOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="AccountEditorScrollColumn" Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="AccountEditorScrollViewer"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AccountPresetEditorTitle}"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Close"
                                            Command="{Binding CloseAccountPresetEditorCommand}"
                                            Padding="10,5"
                                            MinHeight="30"/>
                                </Grid>

                                <Border Style="{StaticResource OrderEditorFirstSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Account details" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <TextBlock Text="Name" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                        <TextBox Text="{Binding AccountPresetName, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding AccountPresetEmail, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Merchant hint" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding Merchants}" SelectedItem="{Binding AccountPresetMerchantHint}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Notes" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <CheckBox Content="Favorite" IsChecked="{Binding AccountPresetIsFavorite}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Notes" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                        <TextBox Text="{Binding AccountPresetNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="108"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <Button Content="Save"
                                                Command="{Binding SaveAccountPresetCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinHeight="38"
                                                Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="New"
                                                    Command="{Binding NewAccountPresetCommand}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Close"
                                                    Command="{Binding CloseAccountPresetEditorCommand}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="4,0,0,0"/>
                                        </UniformGrid>
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyAccountPresetCommand}"
                                                    CommandParameter="{Binding SelectedAccountPreset}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Duplicate"
                                                    Command="{Binding DuplicateAccountPresetCommand}"
                                                    CommandParameter="{Binding SelectedAccountPreset}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="4,0,0,0"/>
                                        </UniformGrid>
                                        <Button Content="View Amazon orders"
                                                Command="{Binding ViewAccountOrdersCommand}"
                                                CommandParameter="{Binding SelectedAccountPreset}"
                                                Style="{StaticResource OrderEditorFooterButtonStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="AccountEditorScrollRail"
                                    Grid.Column="1"
                                    Background="{DynamicResource ScrollBarTrackBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed">
                                <Canvas x:Name="AccountEditorScrollCanvas"
                                        Background="Transparent">
                                    <Thumb x:Name="AccountEditorScrollThumb"
                                           Width="12"
                                           MinHeight="56"
                                           Cursor="SizeNS"
                                           Canvas.Left="1"
                                           Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Canvas>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Presets}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Item Presets" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Reusable item templates with default quantities, costs, merchant hints, and notes." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="New preset" Command="{Binding NewPresetCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save preset"
                                Command="{Binding SavePresetCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsPresetEditorOpen, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding Data.IsPresetEditorOpen, Source={StaticResource VmProxy}, Converter={StaticResource BoolToGridLength}, ConverterParameter=380}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding PresetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="Search presets"
                                     ToolTip="Search presets"/>
                            <WrapPanel Grid.Row="1"
                                       Margin="0,10,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock Text="{Binding PresetBulkSelectionSummary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="Select"
                                        Command="{x:Static local:MainWindow.SelectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=PresetsGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect"
                                        Command="{x:Static local:MainWindow.UnselectHighlightedRowsCommand}"
                                        CommandTarget="{Binding ElementName=PresetsGrid}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Select all"
                                        Command="{Binding SelectVisiblePresetsCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Unselect all"
                                        Command="{Binding ClearSelectedPresetsCommand}"
                                        Style="{StaticResource BulkActionButtonStyle}"/>
                                <Button Content="Delete selected"
                                        Command="{Binding DeleteSelectedPresetsCommand}"
                                        Style="{StaticResource BulkDangerActionButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="0"
                          Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="PresetsScrollColumn" Width="18"/>
                        </Grid.ColumnDefinitions>
                            <DataGrid x:Name="PresetsGrid"
                                      Grid.Column="0"
                                      ItemsSource="{Binding PresetsView}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      AutoGenerateColumns="False"
                                      RowStyle="{StaticResource PresetRowStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.CanContentScroll="False"
                                      SelectionChanged="SelectableGridSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="34" MaxWidth="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Select item preset for bulk actions"
                                                          HorizontalAlignment="Center"
                                                          Margin="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Merchant" Binding="{Binding MerchantHint}" Width="120" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding DefaultQuantity}" Width="60" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding DefaultUnitPrice, StringFormat=C}" Width="90" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTemplateColumn Header="Fav" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          AutomationProperties.Name="Favorite item preset"
                                                          HorizontalAlignment="Center"
                                                          Margin="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Used" Binding="{Binding UsageCount}" Width="70" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTemplateColumn Header="Actions" Width="226">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Edit"
                                                            Command="{Binding Data.EditPresetCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            Margin="0,0,5,0"/>
                                                    <Button Content="Apply"
                                                            Command="{Binding Data.ApplyPresetCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            Margin="0,0,5,0"/>
                                                    <Button Content="Delete"
                                                            Command="{Binding Data.DeletePresetCommand, Source={StaticResource VmProxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GridDangerActionButtonStyle}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        <Border x:Name="PresetsScrollRail"
                                Grid.Column="1"
                                Background="{DynamicResource ScrollBarTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="2,0,0,0"
                                Visibility="Collapsed">
                            <Canvas x:Name="PresetsScrollCanvas"
                                    Background="Transparent">
                                <Thumb x:Name="PresetsScrollThumb"
                                       Width="12"
                                       MinHeight="56"
                                       Cursor="SizeNS"
                                       Canvas.Left="1"
                                       Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Canvas>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1"
                            Grid.RowSpan="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="14,0,0,0"
                            Visibility="{Binding IsPresetEditorOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="PresetEditorScrollColumn" Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PresetEditorScrollViewer"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PresetEditorTitle}"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Close"
                                            Command="{Binding ClosePresetEditorCommand}"
                                            Padding="10,5"
                                            MinHeight="30"/>
                                </Grid>

                                <Border Style="{StaticResource OrderEditorFirstSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Preset details" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Name" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Category" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding PresetCategory, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Merchant hint" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding Merchants}" SelectedItem="{Binding PresetMerchantHint}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Default qty" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding PresetDefaultQuantityInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="1"
                                                         TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Default costs" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Price" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding PresetDefaultUnitPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="0.00"
                                                         TextAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Shipping" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding PresetDefaultShippingInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="0.00"
                                                         TextAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Tax" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                                <TextBox Text="{Binding PresetDefaultTaxInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PlaceholderTextBoxStyle}"
                                                         Tag="0.00"
                                                         TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Notes" Style="{StaticResource OrderEditorSectionTitleStyle}"/>
                                        <CheckBox Content="Favorite" IsChecked="{Binding PresetIsFavorite}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Notes" Style="{StaticResource OrderEditorFieldLabelStyle}"/>
                                        <TextBox Text="{Binding PresetNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="108"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OrderEditorSectionStyle}">
                                    <StackPanel>
                                        <Button Content="Save"
                                                Command="{Binding SavePresetCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinHeight="38"
                                                Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Content="New"
                                                    Command="{Binding NewPresetCommand}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="0,0,4,0"/>
                                            <Button Content="Close"
                                                    Command="{Binding ClosePresetEditorCommand}"
                                                    Style="{StaticResource OrderEditorFooterButtonStyle}"
                                                    Margin="4,0,0,0"/>
                                        </UniformGrid>
                                        <Button Content="Apply to current order"
                                                Command="{Binding ApplyPresetCommand}"
                                                CommandParameter="{Binding SelectedPreset}"
                                                Style="{StaticResource OrderEditorFooterButtonStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="PresetEditorScrollRail"
                                    Grid.Column="1"
                                    Background="{DynamicResource ScrollBarTrackBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed">
                                <Canvas x:Name="PresetEditorScrollCanvas"
                                        Background="Transparent">
                                    <Thumb x:Name="PresetEditorScrollThumb"
                                           Width="12"
                                           MinHeight="56"
                                           Cursor="SizeNS"
                                           Canvas.Left="1"
                                           Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Canvas>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Browser preference, Discord stats, defaults, storage, and visible order columns." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Save settings"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"/>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="SettingsScrollColumn" Width="18"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Column="0"
                                  Style="{StaticResource ModernScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="390"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Appearance and browser" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Theme, launch target, and account-isolated Amazon sessions."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,-4,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,7,0">
                                            <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="Browser" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding BrowserOptions}" SelectedItem="{Binding Settings.BrowserPreference}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Custom browser path" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Settings.CustomBrowserPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                             Tag="Optional executable path"/>
                                    <CheckBox Content="Amazon account sessions"
                                              IsChecked="{Binding Settings.UseAccountBrowserSessions}"
                                              Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Discord webhook" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Send the current dashboard snapshot to a configured webhook."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,-4,0,10"/>
                                    <CheckBox Content="Enable Discord stats" IsChecked="{Binding Settings.DiscordEnabled}"/>
                                    <TextBlock Text="Webhook URL" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding Settings.DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                             Tag="https://discord.com/api/webhooks/..."/>
                                    <Button Content="Send stats now"
                                            Command="{Binding SendDiscordStatsCommand}"
                                            HorizontalAlignment="Left"
                                            MinWidth="140"
                                            Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Defaults and storage" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Starting values for new orders and the local data file location."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,-4,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,7,0">
                                            <TextBlock Text="Default account/email" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding Settings.DefaultAccountEmail, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                                     Tag="Optional default"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="Default merchant" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Merchants}" SelectedItem="{Binding Settings.DefaultMerchant}"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Auto-save changes" IsChecked="{Binding Settings.AutoSave}" Margin="0,14,0,0"/>
                                    <TextBlock Text="Data file" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding DataFilePath, Mode=OneWay}" IsReadOnly="True"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Config maintenance" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock Text="{Binding LegacyOrderItemMigrationStatus}"
                                                       Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Update config"
                                                Command="{Binding MigrateLegacyOrderItemsCommand}"
                                                MinWidth="120"
                                                Margin="16,10,0,0"
                                                VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Orders list columns" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Toggle visible columns without changing your data."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,0,0,10"/>
                                    <UniformGrid Columns="2">
                                        <CheckBox Content="Merchant" IsChecked="{Binding Settings.Columns.ShowMerchant}"/>
                                        <CheckBox Content="Account" IsChecked="{Binding Settings.Columns.ShowAccount}"/>
                                        <CheckBox Content="Order number" IsChecked="{Binding Settings.Columns.ShowOrderNumber}"/>
                                        <CheckBox Content="Items" IsChecked="{Binding Settings.Columns.ShowItem}"/>
                                        <CheckBox Content="Quantity" IsChecked="{Binding Settings.Columns.ShowQuantity}"/>
                                        <CheckBox Content="Status" IsChecked="{Binding Settings.Columns.ShowStatus}"/>
                                        <CheckBox Content="Tracking" IsChecked="{Binding Settings.Columns.ShowTracking}"/>
                                        <CheckBox Content="Dates" IsChecked="{Binding Settings.Columns.ShowDates}"/>
                                        <CheckBox Content="Total" IsChecked="{Binding Settings.Columns.ShowTotal}"/>
                                        <CheckBox Content="Actions" IsChecked="{Binding Settings.Columns.ShowActions}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Projected ROI" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Merchant defaults used by dashboard projections and blank order overrides."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="0,-4,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Settings.MerchantProjectedRoiPercents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="10,7"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Merchant}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ProjectedRoiPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                                                 HorizontalContentAlignment="Right"
                                                                 Margin="10,0,6,0"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="%"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                    <Border x:Name="SettingsScrollRail"
                            Grid.Column="1"
                            Background="{DynamicResource ScrollBarTrackBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="2,0,0,0"
                            Visibility="Collapsed">
                        <Canvas x:Name="SettingsScrollCanvas"
                                Background="Transparent">
                            <Thumb x:Name="SettingsScrollThumb"
                                   Width="12"
                                   MinHeight="56"
                                   Cursor="SizeNS"
                                   Canvas.Left="1"
                                   Style="{StaticResource ScrollBarThumbStyle}"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid Panel.ZIndex="100"
              Grid.ColumnSpan="2"
              Background="{DynamicResource ModalOverlayBrush}"
              Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    Width="420"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="18"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ConfirmationMessage}"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding ConfirmationCancelText}"
                                Command="{Binding CancelDialogCommand}"
                                IsCancel="True"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding ConfirmationConfirmText}"
                                Command="{Binding ConfirmDialogCommand}"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding ConfirmationIsDanger, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        <Button Content="{Binding ConfirmationConfirmText}"
                                Command="{Binding ConfirmDialogCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding ConfirmationIsDanger, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
